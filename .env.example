# Telegram — from @BotFather
TELEGRAM_BOT_TOKEN=

# Active provider: gemini | openai | openrouter | both (both enables /compare)
LIVE_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Live speech-to-speech model (native audio)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Voices: Iapetus, Charon, Kore, Puck, Sulafat — preview in AI Studio
GEMINI_VOICE=Iapetus

# OpenAI Realtime — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
# Voices: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
OPENAI_VOICE=marin

# OpenRouter — https://openrouter.ai/keys
# Uses /v1/chat/completions with modalities: ["text", "audio"]
OPENROUTER_API_KEY=
# Audio-capable models: openai/gpt-audio, openai/gpt-audio-mini
OPENROUTER_MODEL=openai/gpt-audio
OPENROUTER_VOICE=alloy
OPENROUTER_AUDIO_FORMAT=pcm16

ALLOWED_USER_IDS=
MAX_HISTORY_MESSAGES=12
